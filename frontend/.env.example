# Both empty = same origin, which is what the Vite dev proxy provides.
# Set these only when serving a built bundle from somewhere other than :3000.
#
#   VITE_API_BASE=http://localhost:8000      backend (WebSocket is derived from it)
#   VITE_CAMERA_BASE=http://localhost:8001   camera service, unprefixed

VITE_API_BASE=
VITE_CAMERA_BASE=
